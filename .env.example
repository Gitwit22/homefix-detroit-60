# API and database
DATABASE_URL=postgresql://user:password@host/database
CORS_ORIGINS=http://localhost:5173
PORT=4000

# Frontend build
VITE_HOMEFIX_API_URL=http://localhost:4000
VITE_HOMEFIX_DEMO_MODE=1

# Controlled demo features (name-only sessions and resident demo wipe)
HOMEFIX_DEMO_MODE=1

# Private Cloudflare R2 repair-photo storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SIGNED_URL_TTL_SECONDS=3600

# n8n structured triage webhook
N8N_TRIAGE_WEBHOOK_URL=
N8N_HOMEFIX_SECRET=
HOMEFIX_TRIAGE_TIMEOUT_MS=15000
